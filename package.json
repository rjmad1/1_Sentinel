{
  "name": "sentinel-eiip",
  "description": "Enterprise Infrastructure Intelligence Platform (EIIP) - A local-first infrastructure scanning, dependency visualization, and AI review package generator.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "daemon": "node collector/daemon/daemon.cjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:unit": "pwsh -NoProfile -ExecutionPolicy Bypass -Command \"Invoke-Pester -Path tests/unit\"",
    "test:integration": "pwsh -NoProfile -ExecutionPolicy Bypass -Command \"Invoke-Pester -Path tests/integration\"",
    "test:e2e": "npx playwright test",
    "test:evaluate": "node tests/intelligence/evaluateRelease.js"
  },
  "dependencies": {
    "dexie": "^4.4.3",
    "jszip": "^3.10.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.0",
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
